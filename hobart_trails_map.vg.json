{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 650,
  "height": 500,

  "title": {
    "text": "Most Hobart Walking Trails Are Moderate in Difficulty",
    "subtitle": "Walking grades range from 1 (easiest) to 5 (hardest)",
    "anchor": "middle",
    "fontSize": 18,
    "subtitleFontSize": 13,
    "offset": 12
  },

  "data": {
    "url": "data/hobart_trails.json",
    "format": {
      "type": "topojson",
      "feature": "hobart_trails"
    }
  },

  "transform": [
    {
      "filter": "datum.properties.Walk == 'Y'"
    },
    {
      "filter": "datum.properties.Walk_Grade != null && datum.properties.Walk_Grade != 'NA'"
    }
  ],

  "projection": {
    "type": "mercator"
  },

  "mark": {
    "type": "geoshape",
    "fill": null,
    "strokeWidth": 1.8
  },

  "encoding": {
    "stroke": {
      "field": "properties.Walk_Grade",
      "type": "ordinal",
      "title": "Walking Grade",
      "scale": {
        "domain": ["1", "2", "3", "4", "5"],
        "range": [
          "#deebf7",
          "#9ecae1",
          "#6baed6",
          "#3182bd",
          "#08519c"
        ]
      },
      "legend": {
        "orient": "right",
        "title": "Walking Grade",
        "labelExpr": "datum.label == '1' ? 'Grade 1 — Easy' : datum.label == '2' ? 'Grade 2' : datum.label == '3' ? 'Grade 3 — Moderate' : datum.label == '4' ? 'Grade 4' : 'Grade 5 — Hardest'",
        "labelFontSize": 12,
        "titleFontSize": 13,
        "symbolStrokeWidth": 4
      }
    },

    "tooltip": [
      {
        "field": "properties.Name",
        "type": "nominal",
        "title": "Trail"
      },
      {
        "field": "properties.Reserve",
        "type": "nominal",
        "title": "Reserve"
      },
      {
        "field": "properties.Walk_Grade",
        "type": "ordinal",
        "title": "Walking Grade"
      },
      {
        "field": "properties.Status",
        "type": "nominal",
        "title": "Status"
      }
    ]
  },

  "config": {
    "background": "white",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Georgia"
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial"
    }
  }
}