{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 650,
  "height": 650,

  "title": {
    "text": "Most Hobart Walking Trails Are Moderate in Difficulty",
    "subtitle": "Walking grades range from 1 (easiest) to 5 (hardest)",
    "anchor": "middle",
    "fontSize": 18,
    "subtitleFontSize": 13,
    "offset": 12
  },

  "projection": {
    "type": "mercator",
    "center": [147.25, -42.89],
    "scale": 650000
  },

  "layer": [
    {
      "data": {
        "url": "data/australia_states.json",
        "format": {
          "type": "topojson",
          "feature": "STE_2026_AUST_GDA2020"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.STE_NAME26 == 'Tasmania'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#eef3f0",
        "stroke": "#b8c4be",
        "strokeWidth": 1
      }
    },

    {
      "data": {
        "url": "data/hobart_trails.json",
        "format": {
          "type": "topojson",
          "feature": "hobart_trails"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.Walk == 'Y'"
        },
        {
          "filter": "datum.properties.Walk_Grade != null && datum.properties.Walk_Grade != 'NA'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": null,
        "strokeWidth": 1.8
      },
      "encoding": {
        "stroke": {
          "field": "properties.Walk_Grade",
          "type": "ordinal",
          "title": "Walking Grade",
          "scale": {
            "domain": ["1", "2", "3", "4", "5"],
            "range": [
              "#cfe9df",
              "#addccc",
              "#87cbb7",
              "#5ba88e",
              "#2f7f68"
            ]
          },
          "legend": {
            "orient": "right",
            "title": "Walking Grade",
            "labelExpr": "datum.label == '1' ? 'Grade 1 — Easy' : datum.label == '2' ? 'Grade 2' : datum.label == '3' ? 'Grade 3 — Moderate' : datum.label == '4' ? 'Grade 4' : 'Grade 5 — Hardest'",
            "labelFontSize": 12,
            "titleFontSize": 13,
            "symbolStrokeWidth": 4
          }
        },
        "tooltip": [
          {
            "field": "properties.Name",
            "type": "nominal",
            "title": "Trail"
          },
          {
            "field": "properties.Reserve",
            "type": "nominal",
            "title": "Reserve"
          },
          {
            "field": "properties.Walk_Grade",
            "type": "ordinal",
            "title": "Walking Grade"
          },
          {
            "field": "properties.Status",
            "type": "nominal",
            "title": "Status"
          }
        ]
      }
    },

    {
      "data": {
        "values": [
          {
            "name": "Hobart",
            "longitude": 147.3257,
            "latitude": -42.8821
          }
        ]
      },
      "mark": {
        "type": "point",
        "filled": true,
        "size": 55,
        "color": "#233831",
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        }
      }
    },

    {
      "data": {
        "values": [
          {
            "name": "Hobart",
            "longitude": 147.3257,
            "latitude": -42.8821
          }
        ]
      },
      "mark": {
        "type": "text",
        "font": "Arial",
        "fontSize": 12,
        "fontWeight": "bold",
        "align": "left",
        "dx": 8,
        "dy": -6,
        "color": "#233831"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
