{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 650,
  "height": 560,

  "title": {
    "text": "Walking-Track Density Varies Across NSW Regions",
    "subtitle": "Kilometres of walking and hiking tracks per 1,000 km² of region area",
    "anchor": "middle",
    "fontSize": 18,
    "subtitleFontSize": 13,
    "offset": 12
  },

  "data": {
    "url": "data/nsw_npws_branches_density.json",
    "format": {
      "type": "topojson",
      "feature": "branches"
    }
  },

  "transform": [
    {
      "filter": "datum.properties.track_density != null"
    }
  ],

  "projection": {
    "type": "mercator"
  },

  "mark": {
    "type": "geoshape",
    "stroke": "white",
    "strokeWidth": 1.2
  },

  "encoding": {
    "color": {
      "field": "properties.track_density",
      "type": "quantitative",
      "title": "Track Density (km per 1,000 km²)",
      "scale": {
        "scheme": "blues"
      },
      "legend": {
        "orient": "right",
        "titleFontSize": 12,
        "labelFontSize": 11
      }
    },

    "tooltip": [
      {
        "field": "properties.NAME",
        "type": "nominal",
        "title": "NPWS Branch"
      },
      {
        "field": "properties.track_density",
        "type": "quantitative",
        "title": "Track Density",
        "format": ".2f"
      },
      {
        "field": "properties.total_length_km",
        "type": "quantitative",
        "title": "Total Length (km)",
        "format": ".2f"
      },
      {
        "field": "properties.track_count",
        "type": "quantitative",
        "title": "Track Sections"
      },
      {
        "field": "properties.area_km2",
        "type": "quantitative",
        "title": "Region Area (km²)",
        "format": ",.0f"
      }
    ]
  },

  "config": {
    "background": "white",

    "view": {
      "stroke": null
    },

    "title": {
      "font": "Georgia"
    },

    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial"
    }
  }
}