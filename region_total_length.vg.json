{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 620,
  "height": 360,

  "title": {
    "text": "South Coast Has the Greatest Total Walking-Track Length",
    "subtitle": "Total walking and hiking track length by NSW NPWS region",
    "anchor": "middle",
    "fontSize": 18,
    "subtitleFontSize": 13,
    "offset": 12
  },

  "data": {
    "url": "data/nsw_region_trail_totals.csv"
  },

  "transform": [
    {
      "filter": "datum.region != 'Unknown'"
    }
  ],

  "mark": {
    "type": "bar",
    "cornerRadiusEnd": 4
  },

  "encoding": {
    "y": {
      "field": "region",
      "type": "nominal",
      "title": null,
      "sort": "-x",
      "axis": {
        "labelFontSize": 12,
        "labelLimit": 180
      }
    },

    "x": {
      "field": "total_length_km",
      "type": "quantitative",
      "title": "Total Track Length (km)",
      "axis": {
        "grid": true,
        "gridColor": "#e6e6e6"
      }
    },

    "color": {
      "field": "total_length_km",
      "type": "quantitative",
      "legend": null,
      "scale": {
        "scheme": "blues"
      }
    },

    "tooltip": [
      {
        "field": "region",
        "type": "nominal",
        "title": "Region"
      },
      {
        "field": "total_length_km",
        "type": "quantitative",
        "title": "Total Length (km)",
        "format": ".2f"
      },
      {
        "field": "track_count",
        "type": "quantitative",
        "title": "Track Sections"
      }
    ]
  },

  "config": {
    "background": "white",

    "view": {
      "stroke": null
    },

    "title": {
      "font": "Georgia"
    },

    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "titleFontSize": 12
    }
  }
}