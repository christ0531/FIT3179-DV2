{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 620,
  "height": 320,

  "title": {
    "text": "Walking Tracks Dominate the NSW Trail Network",
    "subtitle": "Number of track sections by track type",
    "anchor": "middle",
    "fontSize": 18,
    "subtitleFontSize": 13,
    "offset": 12
  },

  "data": {
    "url": "data/nsw_walking_tracks_clean.csv"
  },

  "transform": [
    {
      "filter": "datum.track_type != null && datum.track_type != ''"
    },
    {
      "aggregate": [
        {
          "op": "count",
          "as": "track_count"
        }
      ],
      "groupby": [
        "track_type"
      ]
    }
  ],

  "mark": {
    "type": "bar",
    "cornerRadiusEnd": 4
  },

  "encoding": {
    "y": {
      "field": "track_type",
      "type": "nominal",
      "title": null,
      "sort": "-x",
      "axis": {
        "labelFontSize": 12
      }
    },

    "x": {
      "field": "track_count",
      "type": "quantitative",
      "title": "Number of Track Sections",
      "axis": {
        "grid": true,
        "gridColor": "#e6e6e6",
        "tickMinStep": 1
      }
    },

    "color": {
      "field": "track_count",
      "type": "quantitative",
      "legend": null,
      "scale": {
        "scheme": "tealblues"
      }
    },

    "tooltip": [
      {
        "field": "track_type",
        "type": "nominal",
        "title": "Track Type"
      },
      {
        "field": "track_count",
        "type": "quantitative",
        "title": "Track Sections"
      }
    ]
  },

  "config": {
    "background": "white",

    "view": {
      "stroke": null
    },

    "title": {
      "font": "Georgia"
    },

    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "titleFontSize": 12
    }
  }
}