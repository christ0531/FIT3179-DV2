{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 650,
  "height": 560,

  "title": {
    "text": "Walking Tracks Are Most Concentrated Around Greater Sydney",
    "subtitle": "Larger and darker circles indicate more track sections within a 0.25° grid cell",
    "anchor": "middle",
    "fontSize": 18,
    "subtitleFontSize": 13,
    "offset": 12
  },

  "projection": {
    "type": "mercator"
  },

  "layer": [
    {
      "data": {
        "url": "data/australia_states.json",
        "format": {
          "type": "topojson",
          "feature": "STE_2026_AUST_GDA2020"
        }
      },

      "transform": [
        {
          "filter": "datum.properties.STE_NAME26 == 'New South Wales'"
        }
      ],

      "mark": {
        "type": "geoshape",
        "fill": "#f3f3f3",
        "stroke": "#777777",
        "strokeWidth": 1
      }
    },

    {
      "data": {
        "url": "data/nsw_walking_tracks_clean.csv"
      },

      "transform": [
        {
          "filter": "datum.longitude != null && datum.latitude != null"
        },
        {
          "calculate": "round(datum.longitude * 4) / 4",
          "as": "grid_longitude"
        },
        {
          "calculate": "round(datum.latitude * 4) / 4",
          "as": "grid_latitude"
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "trail_count"
            }
          ],
          "groupby": [
            "grid_longitude",
            "grid_latitude"
          ]
        }
      ],

      "mark": {
        "type": "circle",
        "opacity": 0.75,
        "stroke": "white",
        "strokeWidth": 0.5
      },

      "encoding": {
        "longitude": {
          "field": "grid_longitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "grid_latitude",
          "type": "quantitative"
        },

        "size": {
          "field": "trail_count",
          "type": "quantitative",
          "title": "Track Sections",
          "scale": {
            "range": [20, 650]
          }
        },

        "color": {
          "field": "trail_count",
          "type": "quantitative",
          "title": "Track Sections",
          "scale": {
            "scheme": "viridis"
          }
        },

        "tooltip": [
          {
            "field": "trail_count",
            "type": "quantitative",
            "title": "Track Sections"
          },
          {
            "field": "grid_latitude",
            "type": "quantitative",
            "title": "Latitude",
            "format": ".2f"
          },
          {
            "field": "grid_longitude",
            "type": "quantitative",
            "title": "Longitude",
            "format": ".2f"
          }
        ]
      }
    },

    {
      "data": {
        "values": [
          {
            "city": "Sydney",
            "longitude": 151.2093,
            "latitude": -33.8688
          },
          {
            "city": "Newcastle",
            "longitude": 151.7817,
            "latitude": -32.9283
          },
          {
            "city": "Wollongong",
            "longitude": 150.8931,
            "latitude": -34.4278
          }
        ]
      },

      "mark": {
        "type": "point",
        "filled": true,
        "size": 50,
        "color": "#222222",
        "stroke": "white",
        "strokeWidth": 0.8
      },

      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },

        "tooltip": [
          {
            "field": "city",
            "type": "nominal",
            "title": "City"
          }
        ]
      }
    },

    {
      "data": {
        "values": [
          {
            "city": "Sydney",
            "longitude": 151.2093,
            "latitude": -33.8688
          }
        ]
      },

      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "dy": -11,
        "font": "Arial",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#222222"
      },

      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },

        "text": {
          "field": "city"
        }
      }
    },

    {
      "data": {
        "values": [
          {
            "city": "Newcastle",
            "longitude": 151.7817,
            "latitude": -32.9283
          }
        ]
      },

      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "dy": -2,
        "font": "Arial",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#222222"
      },

      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },

        "text": {
          "field": "city"
        }
      }
    },

    {
      "data": {
        "values": [
          {
            "city": "Wollongong",
            "longitude": 150.8931,
            "latitude": -34.4278
          }
        ]
      },

      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "dy": 13,
        "font": "Arial",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#222222"
      },

      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },

        "text": {
          "field": "city"
        }
      }
    },

    {
      "data": {
        "values": [
          {
            "label": "NEW SOUTH WALES",
            "longitude": 145.5,
            "latitude": -31.5
          }
        ]
      },

      "mark": {
        "type": "text",
        "font": "Arial",
        "fontSize": 16,
        "fontWeight": "bold",
        "opacity": 0.18,
        "color": "#444444"
      },

      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },

        "text": {
          "field": "label"
        }
      }
    }
  ],

  "config": {
    "background": "white",

    "view": {
      "stroke": null
    },

    "title": {
      "font": "Georgia"
    },

    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 11,
      "titleFontSize": 12
    }
  }
}