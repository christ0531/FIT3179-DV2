{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 650,
  "height": 560,

  "title": {
    "text": "NSW Walking Tracks Vary Widely in Length and Difficulty",
    "subtitle": "Larger circles represent longer track sections. Use the Track Class filter to inspect individual classes.",
    "anchor": "middle",
    "fontSize": 18,
    "subtitleFontSize": 13,
    "offset": 12
  },

  "projection": {
    "type": "mercator"
  },

  "params": [
    {
      "name": "classFilter",
      "value": "All",
      "bind": {
        "input": "select",
        "name": "Track Class: ",
        "options": [
          "All",
          "Class 1 All Access Track",
          "Class 2 Graded Track",
          "Class 3 Walking Track",
          "Class 4 Hiking Track",
          "Class 5 Marked Route",
          "Class 6 Unmarked Route"
        ]
      }
    }
  ],

  "layer": [
    {
      "data": {
        "url": "data/australia_states.json",
        "format": {
          "type": "topojson",
          "feature": "STE_2026_AUST_GDA2020"
        }
      },

      "transform": [
        {
          "filter": "datum.properties.STE_NAME26 == 'New South Wales'"
        }
      ],

      "mark": {
        "type": "geoshape",
        "fill": "#f3f3f3",
        "stroke": "#777777",
        "strokeWidth": 1
      }
    },

    {
      "data": {
        "url": "data/nsw_walking_tracks_clean.csv"
      },

      "transform": [
        {
          "filter": "datum.length_km > 0 && datum.longitude != null && datum.latitude != null"
        },
        {
          "filter": "classFilter == 'All' || datum.track_class == classFilter"
        }
      ],

      "mark": {
        "type": "circle",
        "opacity": 0.55,
        "stroke": "white",
        "strokeWidth": 0.35
      },

      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },

        "size": {
          "field": "length_km",
          "type": "quantitative",
          "title": "Track Length (km)",
          "scale": {
            "range": [5, 120]
          },
          "legend": {
            "orient": "right",
            "titleFontSize": 12,
            "labelFontSize": 11
          }
        },

        "color": {
          "field": "track_class",
          "type": "ordinal",
          "title": "Track Class",
          "scale": {
            "domain": [
              "Class 1 All Access Track",
              "Class 2 Graded Track",
              "Class 3 Walking Track",
              "Class 4 Hiking Track",
              "Class 5 Marked Route",
              "Class 6 Unmarked Route"
            ],
            "range": [
              "#c6dbef",
              "#9ecae1",
              "#6baed6",
              "#4292c6",
              "#2171b5",
              "#084594"
            ]
          },
          "legend": {
            "orient": "right",
            "titleFontSize": 12,
            "labelFontSize": 11,
            "symbolSize": 80
          }
        },

        "tooltip": [
          {
            "field": "trail_name",
            "type": "nominal",
            "title": "Track"
          },
          {
            "field": "track_class",
            "type": "nominal",
            "title": "Track Class"
          },
          {
            "field": "track_type",
            "type": "nominal",
            "title": "Track Type"
          },
          {
            "field": "region",
            "type": "nominal",
            "title": "Region"
          },
          {
            "field": "lga",
            "type": "nominal",
            "title": "LGA"
          },
          {
            "field": "length_km",
            "type": "quantitative",
            "title": "Length (km)",
            "format": ".2f"
          }
        ]
      }
    }
  ],

  "config": {
    "background": "white",

    "view": {
      "stroke": null
    },

    "title": {
      "font": "Georgia"
    },

    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "padding": 8
    }
  }
}